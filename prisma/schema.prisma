generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  scans     Scan[]
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ANALYST)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  scans        Scan[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScanType {
  CONFIG
  CODE
  DOCKERFILE
  MANIFEST
  GENERAL
}

model Scan {
  id          String     @id @default(cuid())
  name        String
  type        ScanType
  content     String
  status      ScanStatus @default(PENDING)
  summary     String?
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  findings    Finding[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model Finding {
  id             String   @id @default(cuid())
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  severity       Severity
  category       String
  title          String
  description    String
  recommendation String
  line          Int?
  source         String   @default("RULE")
  createdAt      DateTime @default(now())
}
